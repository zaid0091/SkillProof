# Copy to backend/.env. Defaults shown target docker-compose services.
# For a database-free local run use: DATABASE_URL=sqlite:///db.sqlite3

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL is the platform database.
DATABASE_URL=postgresql://skillproof:skillproof@localhost:5432/skillproof

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Browsers allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Email (console in development; SMTP in deployed environments)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=SkillProof <no-reply@skillproof.local>

# Upload and execution limits
MAX_SUBMISSION_BYTES=2097152
ASSESSMENT_WORKER_TIMEOUT_SECONDS=60

# GitHub OAuth — Phase 8. Never expose these to the frontend.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
